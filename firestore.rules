rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The real access-control check: is this uid a document in /admins,
    // and is it marked approved. This is what actually protects writes —
    // the client-side login check in src/firebase/auth.ts is only a UX
    // convenience and can't be trusted on its own.
    function isApprovedAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.approved == true;
    }

    function isSuperAdmin() {
      return isApprovedAdmin() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Public, read-only content collections. Anyone can read published
    // content; only approved admins can write.
    match /projects/{id} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }
    match /research/{id} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }
    match /posts/{id} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }
    match /courses/{id} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }
    match /events/{id} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }
    match /team/{id} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }
    match /announcements/{id} {
      allow read: if true;
      allow write: if isApprovedAdmin();
    }

    // Subscribers: anyone can subscribe (create only), only admins can
    // read the list or delete entries.
    match /subscribers/{id} {
      allow create: if true;
      allow read, delete: if isApprovedAdmin();
      allow update: if false;
    }

    // Contact submissions: anyone can submit, only admins can read/manage.
    match /contacts/{id} {
      allow create: if true;
      allow read, update, delete: if isApprovedAdmin();
    }

    // Admin accounts: admins can read their own profile; only a super
    // admin can create/modify/approve other admin accounts.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow read, write: if isSuperAdmin();
    }

    // Regular site users (if/when public accounts are introduced).
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow read: if isApprovedAdmin();
    }
  }
}
